# Local database tooling (SQLTools, ad-hoc queries, session files)
# ------------------------------------------------------------------------------
*.session.sql
**/*.session.sql

# Optional: local scratch queries (keep shared migrations/SQL in repo if needed)
queries/
*.scratch.sql

# SQLTools workspace state (may contain connection metadata)
.sqltools/
