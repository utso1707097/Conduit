@host = http://localhost:5248
@token =
@refreshToken =
@userId =

### Register — success (201)
# @name registerSuccess
POST {{host}}/api/users
Content-Type: application/json

{
  "user": {
    "username": "utso",
    "email": "samaul@nagorik.tech",
    "password": "112233@Aa"
  }
}

###
@token = {{registerSuccess.response.body.$.user.token}}
@refreshToken = {{registerSuccess.response.body.$.user.refreshToken}}

### Login — success (200)
# @name loginSuccess
POST {{host}}/api/users/login
Content-Type: application/json

{
  "user": {
    "email": "samaul@nagorik.tech",
    "password": "112233@Aa"
  }
}

###
@token = {{loginSuccess.response.body.$.user.token}}
@refreshToken = {{loginSuccess.response.body.$.user.refreshToken}}

### Refresh JWT — success (200)
# @name refreshSuccess
POST {{host}}/api/users/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
@token = {{refreshSuccess.response.body.$.user.token}}
@refreshToken = {{refreshSuccess.response.body.$.user.refreshToken}}

### Refresh JWT — unauthorized: unknown token (401)
POST {{host}}/api/users/refresh
Content-Type: application/json

{
  "refreshToken": "invalid-refresh-token"
}

###

### Refresh JWT — validation: blank token (422)
POST {{host}}/api/users/refresh
Content-Type: application/json

{
  "refreshToken": ""
}

###

### Revoke refresh token — success (200)
POST {{host}}/api/users/revoke-refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

### Revoke refresh token — not found (404)
POST {{host}}/api/users/revoke-refresh
Content-Type: application/json

{
  "refreshToken": "missing-refresh-token"
}

###

### List refresh tokens — requires user id from JWT sub claim
# Replace {{userId}} with your user id (JWT payload "sub") after login/register.
GET {{host}}/api/users/{{userId}}/refresh-tokens
Authorization: Token {{token}}

###

### Get current user — success (200)
GET {{host}}/api/user
Authorization: Token {{token}}

###

### Update current user — success (200)
PUT {{host}}/api/user
Authorization: Token {{token}}
Content-Type: application/json

{
  "user": {
    "bio": "I like to skateboard",
    "image": "https://i.stack.imgur.com/xHWG8.jpg"
  }
}

###

### Register — validation error: blank fields (422)
POST {{host}}/api/users
Content-Type: application/json

{
  "user": {
    "username": "",
    "email": "",
    "password": ""
  }
}

###

### Register — conflict: duplicate email (409)
POST {{host}}/api/users
Content-Type: application/json

{
  "user": {
    "username": "jake2",
    "email": "jake@jake.jake",
    "password": "jakejake"
  }
}

###

### Login — unauthorized: wrong password (401)
POST {{host}}/api/users/login
Content-Type: application/json

{
  "user": {
    "email": "jake@jake.jake",
    "password": "wrong-password"
  }
}

###
